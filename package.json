    "@vanilla-extract/css": "^1.21.0",
    "dayjs": "^1.11.18",
    "es-hangul": "^2.3.8",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "linkedom": "^0.18.12",
    "p-map": "^7.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/rss": "^0.0.32",
    "@vanilla-extract/vite-plugin": "^5.2.6",
